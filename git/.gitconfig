[include]
    path = ~/.gitconfig.local

[alias]
    br = branch
    cm = commit
    co = checkout
    graph = log --graph --date=short --decorate=short --pretty=format:'%Cgreen%h %Creset%cd %Cblue%cn %Cred%d %Creset%s'
    sh = stash
    st = status

[color]
    ui = auto

[core]
    editor = nvim
    # 明示しないとgitはgitignore_globalを読まない(デフォルトは~/.config/git/ignore)
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main
